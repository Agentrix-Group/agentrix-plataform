# ==============================================================================
# Agentrix Platform - Environment Variables Template
# Copy this file to .env or export variables before starting services
# ==============================================================================

# Network Port for Backend Monolith
PORT=8080

# PostgreSQL Connection String
DATABASE_URL=postgres://postgres@127.0.0.1:5432/agentrix_platform

# Private JWT Signing Secret (must be at least 32 bytes of secure random text)
# Generate with: openssl rand -hex 32
JWT_SECRET=agentrix_super_secure_private_jwt_secret_token_32_bytes_minimum

# Path to Compiled Rust Arbiter Binary
ARBITER_PATH=simulation/arbiter/target/release/agentrix-arbiter

# Dedicated Storage Directories
BOTS_DIR=var/agentrix/bots
REPLAYS_DIR=var/agentrix/replays

# Continuous Matchmaker Configuration
AUTO_MATCHMAKER=true
MATCH_INTERVAL_SECONDS=30

# Initial Admin Bootstrap (Optional for fresh installations)
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@agentrix.local
# BOOTSTRAP_ADMIN_PASSWORD=SecurePasswordAtLeast16Chars!

# Dedicated Sandbox Runtime (Required for production and isolated runner)
# AGENTRIX_RUNTIME_ROOT=/opt/agentrix/runtime
# AGENTRIX_RUNTIME_SHA256=calculated_runtime_sha256_lowercase
